{
  "uid": "valeosense-overview",
  "title": "ValeoSense pipeline overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "valeosense"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Metrics API reachable",
      "type": "stat",
      "description": "1 = exporter successfully read the API; 0 = scrape failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"valeosense\"}",
          "legendFormat": "Reachable",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Processor reporting",
      "type": "stat",
      "description": "1 = heartbeat less than 5s old; 0 = stale or missing.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_processor_reporting",
          "legendFormat": "Reporting",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Consumer lag",
      "type": "stat",
      "description": "Missing data means no fresh report or no partition assignment; it does not mean zero lag.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_processor_consumer_lag",
          "legendFormat": "Messages",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "QueryFlux verified in API process",
      "type": "stat",
      "description": "1 only after a successful routed query in this API process. Direct mode reports 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_queryflux_verified",
          "legendFormat": "Verified",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Pipeline throughput",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_processor_consumed_per_sec",
          "legendFormat": "Consumed",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "valeosense_simulator_generated_per_sec",
          "legendFormat": "Generated",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_processor_consumer_lag",
          "legendFormat": "Messages",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Processor outcomes per second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(valeosense_processor_accepted_total[$__rate_interval])",
          "legendFormat": "accepted",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "rate(valeosense_processor_duplicates_ignored_total[$__rate_interval])",
          "legendFormat": "duplicates_ignored",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "rate(valeosense_processor_validation_errors_total[$__rate_interval])",
          "legendFormat": "validation_errors",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "rate(valeosense_processor_late_events_total[$__rate_interval])",
          "legendFormat": "late_events",
          "instant": false
        },
        {
          "refId": "E",
          "expr": "rate(valeosense_processor_alerts_generated_total[$__rate_interval])",
          "legendFormat": "alerts_generated",
          "instant": false
        },
        {
          "refId": "F",
          "expr": "rate(valeosense_processor_processor_errors_total[$__rate_interval])",
          "legendFormat": "processor_errors",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Process heartbeat age",
      "type": "timeseries",
      "description": "Redis expires reports after 120s; missing heartbeat age means no retained report.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_processor_heartbeat_age_seconds",
          "legendFormat": "Processor",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "valeosense_simulator_heartbeat_age_seconds",
          "legendFormat": "Simulator",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "API requests and errors",
      "type": "timeseries",
      "description": "Includes monitoring scrapes and health checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(valeosense_api_requests_total[$__rate_interval])",
          "legendFormat": "Requests",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "rate(valeosense_api_errors_total[$__rate_interval])",
          "legendFormat": "Errors",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "API mean request duration",
      "type": "timeseries",
      "description": "Mean only. No latency percentiles are collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(valeosense_api_request_duration_seconds_total[$__rate_interval]) / rate(valeosense_api_requests_total[$__rate_interval])",
          "legendFormat": "Mean duration",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Analytical requests by route",
      "type": "timeseries",
      "description": "Attempted executions; inspect errors separately. Both routes target ClickHouse.",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(valeosense_route_direct_requests_total[$__rate_interval])",
          "legendFormat": "direct",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "rate(valeosense_route_queryflux_requests_total[$__rate_interval])",
          "legendFormat": "queryflux",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
