      "id": 12,
      "title": "Analytical concurrency and errors",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "valeosense-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "valeosense_analytics_running",
          "legendFormat": "Running",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "valeosense_analytics_waiting",
          "legendFormat": "Waiting",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "rate(valeosense_analytics_errors_total[$__rate_interval])",
          "legendFormat": "Errors/sec",
          "instant": false
