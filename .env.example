# Loopback-only demo. Run `make setup` to generate random local credentials.
POSTGRES_USER=valeosense
POSTGRES_DB=valeosense
POSTGRES_PASSWORD=replace-with-random-local-password
API_KEY=replace-with-random-local-api-key
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
CLICKHOUSE_URL=http://localhost:8123
DATABASE_URL=postgresql://valeosense:replace-with-random-local-password@localhost:5434/valeosense
ANALYTICS_ROUTE=direct
QUERYFLUX_URL=http://localhost:18080
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VEHICLE_COUNT=100000
EVENT_RATE=1000
BATCH_SIZE=500
SEED=42
IDLING_THRESHOLD_SECONDS=20
SPEEDING_THRESHOLD_KMH=100
HARSH_BRAKE_THRESHOLD_MPS2=-3
HARSH_ACCEL_THRESHOLD_MPS2=3
IDLE_FUEL_LPH=0.8
FUEL_PRICE_PER_LITRE=100
MAX_ANALYTICAL_QUERIES=4
# Bounded analytical sample; the processor still writes canonical data to ClickHouse.
DUCKDB_WINDOW_MINUTES=120
DUCKDB_VEHICLE_LIMIT=100
DUCKDB_ROW_LIMIT=20000
DUCKDB_SYNC_SECONDS=30
DUCKDB_MAX_AGE_SECONDS=120
# Optional Grafana (make monitoring): defaults to API_KEY when unset.
# GRAFANA_ADMIN_PASSWORD=replace-with-a-separate-random-password
# Optional raw Iceberg archive (make iceberg). Catalog defaults to DATABASE_URL.
ICEBERG_WAREHOUSE=file:///data/iceberg/warehouse
ICEBERG_BATCH_ROWS=5000
ICEBERG_FLUSH_SECONDS=10
# ICEBERG_CATALOG_URI=postgresql+psycopg://user:password@host:5432/catalog
# ICEBERG_TABLE=valeosense.telemetry_archive
# Standard PYICEBERG_CATALOG__VALEOSENSE_ARCHIVE__S3__* settings configure S3 FileIO.
