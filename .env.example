# Loopback-only demo. Run `make setup` to generate random local credentials.
POSTGRES_USER=valeosense
POSTGRES_DB=valeosense
POSTGRES_PASSWORD=replace-with-random-local-password
API_KEY=replace-with-random-local-api-key
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
CLICKHOUSE_URL=http://localhost:8123
DATABASE_URL=postgresql://valeosense:replace-with-random-local-password@localhost:5434/valeosense
ANALYTICS_ROUTE=direct
QUERYFLUX_URL=http://localhost:18080
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VEHICLE_COUNT=100000
EVENT_RATE=1000
BATCH_SIZE=500
SEED=42
IDLING_THRESHOLD_SECONDS=20
IDLE_FUEL_LPH=0.8
FUEL_PRICE_PER_LITRE=100
MAX_ANALYTICAL_QUERIES=4
